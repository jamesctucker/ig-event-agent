# Non-secret dev default only: pre-fill the extension's target Google Sheet ID.
PLASMO_PUBLIC_GOOGLE_SHEET_ID=your-sheet-id-here

# DO NOT add API keys here (e.g. PLASMO_PUBLIC_OPENAI_API_KEY).
# Plasmo inlines PLASMO_PUBLIC_* variables into the built bundle at build time,
# which ships the key in plaintext inside the packaged extension.
# Enter secrets in the extension's Options page instead — they live only in chrome.storage.
